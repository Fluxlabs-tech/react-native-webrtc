# The lab's addresses and devices, for the scripts here. A variable set in the environment wins;
# otherwise edit the defaults for your network. adb picks the Android phone from ANDROID_SERIAL
# when more than one is connected.

# This computer, as the phones reach it (zooplab and mediamtx). Also in mediamtx/mediamtx.yml.
LAB_IP=${LAB_IP:-192.168.1.131}
LAB=${LAB:-http://127.0.0.1:5080}

# The phones: their names in the lab's telemetry, and their addresses (link conditions are per
# address).
ANDROID_NAME=${ANDROID_NAME:-android-AIN065}
ANDROID_IP=${ANDROID_IP:-192.168.1.132}
IOS_NAME=${IOS_NAME:-ios}
IOS_IP=${IOS_IP:-192.168.1.135}

# rebuild.sh: the iPhone's UDID, and the Apple team that signs the example. Without IOS_UDID it
# builds Android only.
IOS_UDID=${IOS_UDID:-}
DEVELOPMENT_TEAM=${DEVELOPMENT_TEAM:-}
