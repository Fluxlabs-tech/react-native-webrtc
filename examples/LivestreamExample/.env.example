# Copy to .env.local (gitignored) to prefill the fields. Restart Metro after a change.

# Watch: a WHEP endpoint, e.g. mediamtx: http://<computer>:8889/live/whep
EXPO_PUBLIC_WHEP_URL=
# Watch from Ant Media: its WebSocket signalling, e.g. wss://<host>:5443/live/websocket, and the stream ID
EXPO_PUBLIC_ANT_MEDIA_URL=
EXPO_PUBLIC_STREAM_ID=
# Go live: a WHIP endpoint, e.g. mediamtx: http://<computer>:8889/live/whip, or Ant Media:
# https://<host>:5443/live/whip/<stream ID>
EXPO_PUBLIC_WHIP_URL=
EXPO_PUBLIC_TOKEN=
# STUN or TURN, e.g. stun:stun.l.google.com:19302. Servers on a public address need none.
EXPO_PUBLIC_ICE_SERVER=
